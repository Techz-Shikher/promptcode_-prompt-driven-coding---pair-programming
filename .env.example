# AI provider credentials stay server-side. Configure at least one provider key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
AI_DEFAULT_MODEL="gemini-3.8-flash"

# Express listener port.
PORT="3000"
TRUST_PROXY_HOPS="0"
REQUIRE_DATABASE="false"

# Per-process API request throttle. Use a shared gateway/limiter for multi-instance deployment.
API_RATE_LIMIT_WINDOW_MS="900000"
API_RATE_LIMIT_MAX_REQUESTS="60"

# Optional external isolated execution service (Judge0 CE-compatible).
# Base URL only, e.g. https://judge0.example.com (server appends /submissions/batch).
# Keep credentials server-side. Use HTTPS except for localhost development.
JUDGE0_API_URL=""
JUDGE0_AUTH_TOKEN=""

# Optional PostgreSQL connection. Required for server-managed accounts, sessions, and project data.
# Migrations in migrations/ are applied automatically during server startup.
DATABASE_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
